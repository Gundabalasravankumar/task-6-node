{
  "info": {
    "name": "Store Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/status"
      }
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anudeep\",\n  \"email\": \"anudeep@example.com\",\n  \"password\": \"123456\",\n  \"age\": 30\n}"
        },
        "url": "http://localhost:3000/api/auth/register"
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"anudeep@example.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": "http://localhost:3000/api/auth/login"
      }
    },
    {
      "name": "Get Users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "http://localhost:3000/api/users"
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"15 inch laptop\",\n  \"price\": 75000,\n  \"category\": \"Electronics\",\n  \"stock\": 10\n}"
        },
        "url": "http://localhost:3000/api/products"
      }
    }
  ]
}
